{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kawer95/Animania-1.20.1/schema/closure-evidence-v2.json",
  "title": "Animania closure evidence v2",
  "type": "object",
  "required": ["schema_version", "audit_id", "audit_version", "source_revision", "auditor_path", "auditor_sha256", "results"],
  "properties": {
    "schema_version": {"const": 2},
    "audit_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
    "audit_version": {"type": "string", "pattern": "^v[0-9]+$"},
    "source_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "command": {"type": "string", "minLength": 1},
    "auditor_path": {"type": "string", "minLength": 1},
    "auditor_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "results": {"type": "array", "items": {"$ref": "#/$defs/result"}}
  },
  "$defs": {
    "result": {
      "type": "object",
      "required": ["entry_id", "requirement_id", "result", "source_sha256", "target_paths", "tests", "evidence_kind", "test_code_path", "test_code_sha256"],
      "properties": {
        "entry_id": {"type": "string", "pattern": "^[0-9a-f]{24}$"},
        "requirement_id": {"enum": ["implementation", "behavior", "serialization", "resource", "client", "integration"]},
        "result": {"enum": ["pass", "fail", "skipped", "aborted"]},
        "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "target_paths": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/path"}},
        "tests": {"type": "array", "items": {"$ref": "#/$defs/test"}},
        "test_code_path": {"type": "string", "minLength": 1},
        "test_code_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "equivalence_group": {"type": "string", "minLength": 1},
        "source_structure_signature": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "evidence_kind": {"enum": ["binary_identity", "normalized_json", "locale_mapping", "source_mapping", "executed_test", "client_snapshot", "integration_launch"]},
        "notes": {"type": "array", "items": {"type": "string"}}
      }
    },
    "path": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "symbol": {"type": "string"}
      }
    },
    "test": {
      "type": "object",
        "required": ["selector", "result", "artifact", "artifact_sha256"],
      "properties": {
        "selector": {"type": "string", "minLength": 1},
        "result": {"enum": ["pass", "fail", "skipped", "aborted"]},
        "artifact": {"type": "string"},
        "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
